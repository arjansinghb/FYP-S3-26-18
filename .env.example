# Copy to .env and fill in real values. Never commit .env itself (already
# gitignored) — this file is the template, committed on purpose.

# --- Firebase (client config) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Firebase Admin SDK (backend only) ---
# Download the service-account JSON from Firebase console > Project Settings >
# Service Accounts. Keep the actual file out of git (e.g. under secrets/).
FIREBASE_ADMIN_CREDENTIALS_PATH=./secrets/firebase-admin.json

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Content source APIs ---
GOOGLE_BOOKS_API_KEY=
YOUTUBE_DATA_API_KEY=

# --- Payments (PA24-27) ---
# Leave blank for local dev/demo — billing runs against SimulatedPaymentProvider
# (no real charges, no external account needed). Only fill this in for a real
# production deployment; see src/backend/app/services/payment/stripe_provider.py
# for what else that swap-in still needs implementing.
STRIPE_API_KEY=

# --- Web Push (PA20/PA22) — a standalone VAPID keypair (not FCM — see
# src/backend/app/services/push_service.py for why). Generate your own with:
#   python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
# (see that same module's dev-session 2026-08-17 note for the full snippet)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:3000

# --- Backend session/tuning knobs (all have working defaults — see
# src/backend/app/core/config.py; only SESSION_SECRET needs a real value
# before any real deployment) ---
SESSION_SECRET=dev-only-insecure-secret-change-me
CLARIFYING_ROUND_CAP=2
FREE_TIER_FAVOURITES_CAP=5
RECOMMENDATION_BATCH_SIZE=3
