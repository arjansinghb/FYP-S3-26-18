# Copy this file to ".env" and fill in values as they become available.
# The backend runs fine with NONE of these set (placeholder brain, in-memory
# storage that resets on restart). Note: this backend also auto-loads the repo
# ROOT .env if one exists (see config.py) — if you already have that filled in
# for the other branch, you likely don't need a backend-local .env at all.

# Which brain powers Pip: placeholder | openai | anthropic
# Leave unset to auto-detect: "openai" once OPENAI_API_KEY is set, else
# "placeholder".
BRAIN_PROVIDER=

# PA03 password reset: set to true ONLY for local development without an email
# service, so the reset code is returned in the API response. Never in a deployed app.
DEV_RETURN_RESET_TOKEN=

# LLM keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- OpenAI Zero Data Retention (ZDR) — URS §2.5 Constraint 3 / Assumption 3
# flags this as a real, unresolved compliance question for under-13 users.
# Nothing here can actually secure ZDR (that's a real agreement with OpenAI,
# not a setting) — this just makes the CURRENT status visible in logs/admin
# config instead of silently pretending it's resolved. See config.py's
# ZDR_STATUS docstring for what each value means.
#   unresolved (default) | accepted_risk | confirmed
ZDR_STATUS=unresolved
# Strips likely-PII patterns (email/phone/address) from a child's message
# before it reaches OpenAI — a real, separate mitigation, on regardless of
# ZDR_STATUS. See app/pii.py.
PII_SCRUB_ENABLED=true

# --- Firebase (Firestore persistence for storage.py — see
# app/firestore_store.py). Leave blank to keep the original in-memory-only
# behaviour. ---
FIREBASE_PROJECT_ID=
# Path to the Admin SDK service-account JSON (Firebase console > Project
# Settings > Service Accounts). Keep the actual file out of git.
FIREBASE_ADMIN_CREDENTIALS_PATH=./secrets/firebase-admin.json

# --- Content source APIs (Google Books/YouTube search — CM03/CM06 moderator
# import flow, app/content_sources.py). Leave blank and search just returns
# an empty list. ---
GOOGLE_BOOKS_API_KEY=
YOUTUBE_DATA_API_KEY=

# Which web origins may call the API (regex). Default allows any localhost port.
CORS_ORIGIN_REGEX=http://localhost:\d+
