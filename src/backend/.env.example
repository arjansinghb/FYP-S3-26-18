# Copy this file to ".env" and fill in values as they become available.
# The backend runs fine with NONE of these set (placeholder brain, no DB).

# Which brain powers Pip: placeholder | openai | anthropic
BRAIN_PROVIDER=placeholder

# LLM keys (only needed once BRAIN_PROVIDER is switched away from placeholder)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which web origins may call the API (regex). Default allows any localhost port.
CORS_ORIGIN_REGEX=http://localhost:\d+
